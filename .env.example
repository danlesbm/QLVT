# Cổng chạy ứng dụng và địa chỉ truy cập
PORT=3000
BASE_URL=http://localhost:3000
# Đặt 1 khi chạy sau HTTPS
COOKIE_SECURE=0
SESSION_HOURS=12

# Nơi lưu CSDL SQLite và tệp đính kèm (báo giá, tờ trình); đường dẫn tương đối tính từ thư mục ứng dụng
DB_FILE=./data/qlvt.db
UPLOAD_DIR=./data/uploads
# Thư mục chứa bản sao lưu (npm run backup)
BACKUP_DIR=./data/backup

# ===== SSO Portal (giống app Payroll, không cần sửa SSO) =====
# Có SSO_BASE_URL thì app dùng SSO Portal: SSO mở app kèm ?token=..., app xác thực qua {SSO_BASE_URL}/api/auth/introspect.
# Để trống thì chạy SSO giả lập (chọn người trong danh bạ mẫu) để thử; production (NODE_ENV=production) sẽ không chạy.
SSO_BASE_URL=https://ssotest.sbm.com.vn
# PHẢI TRÙNG với SSO_INTERNAL_API_SECRET trong .env của SSO (để đọc danh bạ nhân sự / phòng ban / chức vụ)
SSO_INTERNAL_API_SECRET=PUT_THE_SAME_SECRET_AS_SSO
# Trang SSO Portal hiện trên màn hình đăng nhập (mặc định = SSO_BASE_URL)
# SSO_PORTAL_URL=https://sso.sbm.com.vn
# Quản trị trên SSO là quản trị QLVT
SSO_ADMIN_IS_ADMIN=true
# Đồng bộ danh bạ định kỳ (phút); SSO cũng có thể gọi POST /api/internal/sync với header X-Internal-Secret
SYNC_INTERVAL_MIN=30
# Các nguồn được phép nhúng QLVT trong iframe (SSO Portal)
FRAME_ANCESTORS="'self' https://*.sbm.com.vn"
# Cookie phiên: lax (SSO Portal cùng tên miền *.sbm.com.vn). Nhúng từ tên miền khác thì đặt none (bắt buộc HTTPS)
COOKIE_SAMESITE=lax

# Người luôn có quyền quản trị QLVT (phân quyền lần đầu), cách nhau bởi dấu phẩy
QLVT_BOOTSTRAP_EMAILS=
ADMIN_SSO_IDS=
