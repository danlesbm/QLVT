# Cổng chạy ứng dụng và địa chỉ truy cập
PORT=3000
BASE_URL=http://localhost:3000
# Đặt 1 khi chạy sau HTTPS
COOKIE_SECURE=0
SESSION_HOURS=12

# Nơi lưu CSDL SQLite và tệp đính kèm (báo giá, tờ trình)
DB_FILE=./data/qlvt.db
UPLOAD_DIR=./data/uploads

# ===== SSO =====
# mock = SSO giả lập để chạy thử; oidc = SSO thật của công ty (OpenID Connect)
SSO_MODE=mock
SSO_AUTHORIZE_URL=https://sso.sbm.com.vn/oauth/authorize
SSO_TOKEN_URL=https://sso.sbm.com.vn/oauth/token
SSO_USERINFO_URL=https://sso.sbm.com.vn/oauth/userinfo
SSO_LOGOUT_URL=https://sso.sbm.com.vn/logout
SSO_CLIENT_ID=qlvt
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/auth/callback
SSO_SCOPE=openid profile email
# Trường định danh người dùng trong userinfo (mặc định sub)
SSO_CLAIM_ID=sub
# API danh bạ: {URL}/departments, /positions, /employees
SSO_DIRECTORY_URL=https://sso.sbm.com.vn/api
SSO_DIRECTORY_TOKEN=
SSO_SYNC_MINUTES=60

# Mã SSO của người luôn có quyền quản trị (phân quyền lần đầu), cách nhau bởi dấu phẩy
ADMIN_SSO_IDS=nv900
