<%- include('../partials/head') %>
<%- include('nav') %>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3"><div class="card-body">
      <h2 class="h5 mb-1"><%= u.full_name %></h2>
      <div class="text-muted small"><%= [u.position_name, u.department_name, u.email].filter(Boolean).join(' · ') %> · Mã SSO: <%= u.sso_id %><% if (u.sso_admin) { %> · <span class="badge text-bg-dark">Quản trị trên SSO</span><% } %></div>
      <% if (units.length) { %><div class="small mt-2">Đơn vị trên SSO:
        <% units.forEach((x, i) => { %><%= i ? ', ' : '' %><span class="<%= x.member ? '' : 'text-muted' %>"><%= x.name %><%= x.role ? ' (' + x.role + ')' : '' %><% if (x.member && x.factory_name) { %> <span class="badge text-bg-success fw-normal">nhân sự kho <%= x.factory_name %></span><% } %></span><% }) %>
      </div><% } %>
    </div></div>
    <div class="card"><div class="card-header">Quyền đã gán</div>
      <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Nhóm quyền</th><th>Phạm vi</th><th></th></tr></thead><tbody>
        <% if (!assigned.length) { %><tr><td colspan="3" class="text-muted text-center py-3">Chưa có quyền nào.</td></tr><% } %>
        <% assigned.forEach(a => { %><tr class="<%= a.stale ? 'text-muted' : '' %>"><td><%= a.role_name %></td><td><%= a.factory_name || 'Toàn công ty' %><% if (a.stale) { %> <span class="badge text-bg-warning fw-normal" title="Quyền vận hành kho chỉ có hiệu lực với nhân sự của kho (theo SSO)">không hiệu lực: không thuộc kho này</span><% } %></td>
          <td class="text-end"><form method="post" action="/cai-dat/nguoi-dung/<%= u.id %>/bo/<%= a.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-link text-danger p-0">Bỏ</button></form></td></tr><% }) %>
      </tbody></table></div>
    </div>
    <% if (isAdmin && u.id !== user.id) { %>
    <form method="post" action="/cai-dat/nguoi-dung/<%= u.id %>/quan-tri" class="mt-3" data-confirm="Xác nhận thay đổi quyền quản trị hệ thống?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="is_admin" value="<%= u.is_admin ? 0 : 1 %>">
      <button class="btn btn-sm btn-outline-dark"><%= u.is_admin ? 'Bỏ quyền quản trị hệ thống' : 'Cấp quyền quản trị hệ thống (toàn quyền)' %></button></form>
    <% } %>
  </div>
  <div class="col-lg-5">
    <div class="card"><div class="card-header">Gán thêm quyền</div><div class="card-body">
      <form method="post" action="/cai-dat/nguoi-dung/<%= u.id %>/gan"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="form-label small">Nhóm quyền</label>
        <select name="role_id" class="form-select mb-3" required><% roles.forEach(r => { %><option value="<%= r.id %>"><%= r.name %><%= r.plant ? ' · chỉ nhân sự của kho' : '' %></option><% }) %></select>
        <label class="form-label small">Phạm vi (bỏ trống = toàn công ty)</label>
        <% factories.forEach(f => { %><div class="form-check"><input class="form-check-input" type="checkbox" name="factory_ids" value="<%= f.id %>" id="f<%= f.id %>"><label class="form-check-label" for="f<%= f.id %>"><%= f.name %><% if (members.has(f.id)) { %> <span class="badge text-bg-success fw-normal">thuộc kho</span><% } %></label></div><% }) %>
        <div class="form-text mb-3">Quyền theo kho chỉ có hiệu lực ở kho được chọn. Thủ kho, GĐ nhà máy, người tổng hợp đề xuất (nhóm ghi "chỉ nhân sự của kho") gán theo kho chỉ cho người thuộc đơn vị của kho đó trên SSO. Quyền cấp công ty (PKT, Kế hoạch, Ban Giám đốc, đánh mã, xem) gán cho người ở bất kỳ phòng ban nào.</div>
        <button class="btn btn-primary w-100">Gán quyền</button>
      </form>
    </div></div>
  </div>
</div>
<%- include('../partials/foot') %>
