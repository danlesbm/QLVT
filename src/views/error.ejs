<% if (locals.user) { %><%- include('partials/head') %><% } else { %><!doctype html><html lang="vi"><head><meta charset="utf-8"><title><%= title %></title><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"></head><body class="p-4"><% } %>
<div class="card border-0 shadow-sm mx-auto" style="max-width:560px">
  <div class="card-body text-center p-5">
    <i class="bi bi-exclamation-triangle text-warning display-5"></i>
    <h1 class="h4 mt-3"><%= title %></h1>
    <p class="text-muted"><%= message %></p>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">Quay lại</a>
    <a href="/" class="btn btn-primary">Trang chủ</a>
  </div>
</div>
<% if (locals.user) { %><%- include('partials/foot') %><% } else { %></body></html><% } %>
