<%- include('../partials/head') %>
<div class="card"><div class="card-body">
  <ul class="nav nav-pills mb-3 small flex-nowrap overflow-auto">
    <% [['', 'Tất cả'], ['DANG_XU_LY', 'Đang xử lý'], ['TRA_LAI', 'Bị từ chối'], ['CHO_DUYET_NHU_CAU', 'Chờ duyệt nhu cầu'], ['DANG_BAO_GIA', 'Đang báo giá'], ['DANG_MUA_SAM', 'Đang mua sắm'], ['HOAN_THANH', 'Hoàn thành']].forEach(([k, l]) => { %>
      <li class="nav-item"><a class="nav-link text-nowrap <%= (query.status || '') === k ? 'active' : '' %>" href="<%= h.qs(query, { status: k, page: '' }) %>"><%= l %></a></li>
    <% }) %>
  </ul>
  <form class="row g-2 align-items-end mb-3" method="get">
    <div class="col-md-3"><select name="factory_id" class="form-select" onchange="this.form.submit()"><option value="">Tất cả nhà máy</option>
      <% factories.forEach(f => { %><option value="<%= f.id %>" <%= String(query.factory_id) === String(f.id) ? 'selected' : '' %>><%= f.name %></option><% }) %></select></div>
    <div class="col-md-3"><select name="status" class="form-select" onchange="this.form.submit()"><option value="">Mọi trạng thái</option><option value="DANG_XU_LY" <%= query.status === 'DANG_XU_LY' ? 'selected' : '' %>>Đang xử lý (chưa xong)</option>
      <% Object.entries(STATUS).forEach(([k, st]) => { %><option value="<%= k %>" <%= query.status === k ? 'selected' : '' %>><%= st.label %></option><% }) %></select></div>
    <div class="col-md-3"><input name="q" class="form-control" value="<%= query.q || '' %>" placeholder="Số phiếu, tiêu đề, tên vật tư..."></div>
    <div class="col-md-3 d-flex gap-2 justify-content-md-end">
      <div class="form-check align-self-center"><input class="form-check-input" type="checkbox" name="mine" value="1" id="mine" <%= query.mine === '1' ? 'checked' : '' %> onchange="this.form.submit()"><label for="mine" class="form-check-label small">Phiếu của tôi</label></div>
      <% if (canCreate) { %><a href="/de-xuat/moi" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Lập phiếu</a><% } %>
    </div>
  </form>
  <div class="table-responsive"><table class="table table-hover">
    <thead><tr><th>Số phiếu</th><th>Tiêu đề</th><th>Nhà máy</th><th>Người lập</th><th class="text-center">Số VT</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Chưa có phiếu nào.</td></tr><% } %>
      <% rows.forEach(r => { %>
        <tr onclick="location.href='/de-xuat/<%= r.id %>'" style="cursor:pointer">
          <td class="text-nowrap fw-semibold"><a href="/de-xuat/<%= r.id %>"><%= r.number || '(nháp)' %></a></td>
          <td><%= r.title %></td><td class="small"><%= r.factory_name %></td><td class="small"><%= r.creator_name %></td>
          <td class="text-center"><%= r.item_count %></td>
          <td><%- include('../partials/badge', { st: STATUS[r.status] }) %></td>
          <td class="small text-nowrap"><%= h.date(r.updated_at, true) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../partials/pager') %>
</div></div>
<%- include('../partials/foot') %>
